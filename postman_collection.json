{
    "info": {
        "name": "Diagnosis Kerusakan Dinamo API",
        "description": "API Documentation untuk Sistem Pakar Diagnosis Kerusakan Dinamo dengan Random Forest Manual",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "variable": [
        {
            "key": "base_url",
            "value": "http://127.0.0.1:5000",
            "type": "string"
        },
        {
            "key": "token",
            "value": "YOUR_TOKEN_HERE",
            "type": "string"
        }
    ],
    "item": [
        {
            "name": "1. Authentication",
            "item": [
                {
                    "name": "Register",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/auth/register",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "auth",
                                "register"
                            ]
                        },
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"nama_lengkap\": \"John Doe\",\n    \"username\": \"johndoe\",\n    \"password\": \"password123\",\n    \"confirm_password\": \"password123\"\n}"
                        }
                    },
                    "response": [
                        {
                            "name": "Success (201)",
                            "status": "Created",
                            "code": 201,
                            "_postman_previewlanguage": "json",
                            "body": "{\n    \"success\": true,\n    \"message\": \"Registrasi berhasil! Selamat datang di sistem.\",\n    \"token\": \"eyJhbGciOiJIUzI1NiIsInR5...\"\n}"
                        },
                        {
                            "name": "Error - Password Mismatch (400)",
                            "status": "Bad Request",
                            "code": 400,
                            "_postman_previewlanguage": "json",
                            "body": "{\n    \"success\": false,\n    \"message\": \"Password dan Konfirmasi Password tidak cocok.\"\n}"
                        }
                    ]
                },
                {
                    "name": "Login",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/auth/login",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "auth",
                                "login"
                            ]
                        },
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"username\": \"johndoe\",\n    \"password\": \"password123\"\n}"
                        }
                    },
                    "response": [
                        {
                            "name": "Success (200)",
                            "status": "OK",
                            "code": 200,
                            "_postman_previewlanguage": "json",
                            "body": "{\n    \"success\": true,\n    \"message\": \"Login berhasil.\",\n    \"token\": \"eyJhbGciOiJIUzI1NiIsInR5...\",\n    \"user\": {\n        \"id\": 1,\n        \"username\": \"johndoe\",\n        \"nama_lengkap\": \"John Doe\"\n    }\n}"
