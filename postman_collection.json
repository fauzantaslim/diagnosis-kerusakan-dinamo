                            "status": "OK",
                            "code": 200,
                            "_postman_previewlanguage": "json",
                            "body": "{\n    \"success\": true,\n    \"diagnosis\": \"Kerusakan Bearing\",\n    \"confidence\": 0.76,\n    \"confidence_pct\": \"76.00%\",\n    \"session_id\": \"c1b5162c-84f5-4369-9480-7e0dc3c9a80c\",\n    \"calculation_detail\": {\n        \"n_trees\": 50,\n        \"n_training_samples\": 201,\n        \"majority_votes\": {\n            \"Kerusakan Bearing\": 38,\n            \"Kerusakan Shaft\": 12\n        }\n    }\n}"
                        },
                        {
                            "name": "Error - No Symptoms (400)",
                            "status": "Bad Request",
                            "code": 400,
                            "_postman_previewlanguage": "json",
                            "body": "{\n    \"success\": false,\n    \"message\": \"Validasi gagal: Mohon pilih minimal satu gejala yang teridentifikasi.\"\n}"
                        }
                    ]
                },
                {
                    "name": "Get Specific Tree Detail",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}"
                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/api/rf/tree/:session_id/:tree_id",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "rf",
                                "tree",
                                ":session_id",
                                ":tree_id"
                            ],
                            "variable": [
                                {
                                    "key": "session_id",
                                    "value": "YOUR_SESSION_ID"
                                },
                                {
                                    "key": "tree_id",
                                    "value": "0"
                                }
                            ]
                        }
                    },
                    "response": [
                        {
                            "name": "Success (200)",
                            "status": "OK",
                            "code": 200,
                            "_postman_previewlanguage": "json",
                            "body": "{\n    \"success\": true,\n    \"tree_id\": 0,\n    \"vote\": \"Kerusakan Bearing\",\n    \"path_length\": 8,\n    \"nodes\": [\n        {\n            \"id\": \"1\",\n            \"data\": {\n                \"type\": \"decision\",\n                \"gini\": 0.7165\n            }\n        }\n    ],\n    \"edges\": [\n        {\n            \"id\": \"e1-2\",\n            \"source\": \"1\",\n            \"target\": \"2\"\n        }\n    ],\n    \"sampling_detail\": {\n        \"n_total\": 250,\n        \"bootstrap\": {\n            \"n_unique_samples\": 127\n        }\n    }\n}"
                        },
                        {
                            "name": "Error - Session Expired (404)",
                            "status": "Not Found",
                            "code": 404,
                            "_postman_previewlanguage": "json",
                            "body": "{\n    \"success\": false,\n    \"message\": \"Session tidak ditemukan atau sudah expired (10 menit). Lakukan prediksi ulang.\"\n}"
                        }
                    ]
                },
                {
                    "name": "Get All Trees Summary",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}"
                            }
                        ],
                        "url": {
