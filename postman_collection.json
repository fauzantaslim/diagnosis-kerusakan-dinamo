                            "code": 401,
                            "_postman_previewlanguage": "json",
                            "body": "{\n    \"success\": false,\n    \"message\": \"Login gagal. Periksa kembali username dan password Anda.\"\n}"
                        }
                    ]
                },
                {
                    "name": "Get Current User (Me)",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}"
                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/auth/me",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "auth",
                                "me"
                            ]
                        }
                    },
                    "response": [
                        {
                            "name": "Success (200)",
                            "status": "OK",
                            "code": 200,
                            "_postman_previewlanguage": "json",
                            "body": "{\n    \"success\": true,\n    \"user\": {\n        \"id\": 1,\n        \"username\": \"johndoe\",\n        \"nama_lengkap\": \"John Doe\"\n    }\n}"
                        },
                        {
                            "name": "Error - Unauthorized (401)",
                            "status": "Unauthorized",
                            "code": 401,
                            "_postman_previewlanguage": "json",
                            "body": "{\n    \"success\": false,\n    \"message\": \"Token tidak ditemukan. Silakan login terlebih dahulu.\"\n}"
                        }
                    ]
