                {
                    "name": "Logout",
                    "request": {
                        "method": "POST",
                        "header": [],
                        "url": {
                            "raw": "{{base_url}}/auth/logout",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "auth",
                                "logout"
                            ]
                        }
                    },
                    "response": [
                        {
                            "name": "Success (200)",
                            "status": "OK",
                            "code": 200,
                            "_postman_previewlanguage": "json",
                            "body": "{\n    \"success\": true,\n    \"message\": \"Logout berhasil.\",\n    \"redirect\": \"/auth/login\"\n}"
                        }
                    ]
                }
            ]
        },
        {
            "name": "2. Diagnosis (Random Forest)",
            "item": [
                {
                    "name": "Identify (Predict)",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/diagnosis/identify",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "diagnosis",
                                "identify"
                            ]
                        },
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"suara_bising_abnormal\": \"Ya\",\n    \"bau_hangus\": \"Tidak\",\n    \"indikasi_overheating\": \"Ya\",\n    \"putaran_poros_seret\": \"Tidak\",\n    \"getaran_berlebih\": \"Ya\",\n    \"terminal_overheating\": \"Tidak\",\n    \"kipas_pendingin_rusak\": \"Tidak\",\n    \"cooling_duct_tersumbat\": \"Tidak\",\n    \"resistansi_isolasi_tidak_seimbang\": \"Ya\",\n    \"resistansi_winding_tidak_seimbang\": \"Ya\",\n    \"arus_antar_fasa_tidak_seimbang\": \"Ya\",\n    \"daya\": \"10\",\n    \"jumlah_pole\": \"4\",\n    \"kecepatan_putaran_rpm\": \"1450\"\n}"
                        }
                    },
